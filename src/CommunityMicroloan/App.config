<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <connectionStrings>
        <!-- Point this at your own SQL Server instance (restore database\b_info.bacpac first). -->
        <add name="b_info"
             connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=b_info;Integrated Security=True"
             providerName="System.Data.SqlClient" />
    </connectionStrings>
</configuration>